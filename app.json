{
  "expo": {
    "plugins": ["expo-font"],
    "name": "MoodLink",
    "slug": "capstone1",
    "scheme": "moodlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jayveeerandio.capstone",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jayveeerandio.capstone"
    },
    "web": {
      "favicon": "./assets/logo_icon.png",
      "bundler": "metro"
    },
    "owner": "jperandio",
    "extra": {
      "eas": {
        "projectId": "ac5b7a1d-d4dc-4c22-839c-c673d5e7fdf8"
      }
    }
  }
}
